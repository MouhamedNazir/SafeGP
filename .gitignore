# Config avec identifiants (ne jamais committer)
config.php

# Photos uploadées par les utilisateurs (données, pas du code)
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Fichiers système
.DS_Store
Thumbs.db

# Journaux d'erreurs et e-mails enregistrés en local
logs/*
!logs/.htaccess

# Pièces d'identité envoyées pour le badge « vérifié » (données privées)
verifications/*
!verifications/.htaccess

# Preuves de paiement et photos des colis (données privées)
preuves/*
!preuves/.htaccess
